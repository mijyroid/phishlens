# All keys are optional. Without them, PhishLens still runs every local check
# and the report marks the matching source as "skipped".

# Google Safe Browsing (free, non-commercial): https://developers.google.com/safe-browsing/v4/get-started
SAFE_BROWSING_API_KEY=

# URLhaus by abuse.ch (free Auth-Key): https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# Optional AI-written explanation. Only findings, subject and sender are sent, never the email body.
ANTHROPIC_API_KEY=
PHISHLENS_LLM_MODEL=claude-haiku-5-5

# Limits
PHISHLENS_MAX_EMAIL_BYTES=2000000
PHISHLENS_RATE_LIMIT=20
PHISHLENS_INTEL_TIMEOUT=5
